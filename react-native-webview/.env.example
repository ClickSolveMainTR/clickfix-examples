# Public widget id (Web widget -> Install).
EXPO_PUBLIC_CLICKFIX_WIDGET_ID=replace_me
# ClickFix app origin: serves widget-embed.html and the visitor API under /api.
EXPO_PUBLIC_CLICKFIX_APP_ORIGIN=https://getclickfix.com
# Mobile app key (Web widget -> Advanced -> Mobile apps), created for the package name in app.json.
# A key is not a secret like the API key, but it is bound to this app: keep it out of web pages.
EXPO_PUBLIC_CLICKFIX_APP_KEY=replace_me
# Your own backend that computes user_hash (e.g. ../node-express or ../go-server running locally).
# On a device use your machine's LAN address instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
