# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app, so only
# public identifiers belong here; the identity secret stays with server.mjs.
# ClickFix app origin (serves widget.js; the visitor API is under /api). Not api.getclickfix.com.
EXPO_PUBLIC_CLICKFIX_BASE_URL=https://getclickfix.com
# Public widget id (Web widget -> Install).
EXPO_PUBLIC_CLICKFIX_WIDGET_ID=replace_me
# Mobile app key (Web widget -> Advanced -> Mobile apps), created for com.example.clickfix.
EXPO_PUBLIC_CLICKFIX_APP_KEY=replace_me
# The user_hash server (server.mjs, port 8787). On a phone use your machine's LAN address.
EXPO_PUBLIC_SUPPORT_SERVER_URL=http://localhost:8787
# Only in Expo Go: the package name registered with a development app key.
# EXPO_PUBLIC_CLICKFIX_PACKAGE_NAME=com.example.clickfix.dev
