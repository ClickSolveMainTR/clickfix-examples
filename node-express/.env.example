# ClickFix public API (no /v1 suffix). Use the stub from ../tools for offline runs.
CLICKFIX_BASE_URL=https://api.getclickfix.com
# Organization -> API and automations -> API keys (cf_sk_...). Scopes used here:
# contacts:read, contacts:write, companies:read, events:write
CLICKFIX_API_KEY=cf_sk_replace_me
# Web widget -> Security -> Identity verification (shown once, server only)
CLICKFIX_IDENTITY_SECRET=replace_me
# data.secret of POST /v1/public-api/webhooks (shown once)
CLICKFIX_WEBHOOK_SECRET=replace_me
PORT=3000
