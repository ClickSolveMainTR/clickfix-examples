{
    "name": "clickfix-examples/php-plain",
    "description": "ClickFix example: plain PHP with clickfix/sdk and Guzzle (identity hash, contacts, company, events, webhooks).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "clickfix/sdk": "^0.1.0",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
