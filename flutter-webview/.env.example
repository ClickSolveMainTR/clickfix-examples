# Flutter has no .env loader by default; pass these with --dart-define, e.g.
#   flutter run --dart-define=CLICKFIX_WIDGET_ID=... --dart-define=API_URL=http://10.0.2.2:3000
# Public widget id (Web widget -> Install)
CLICKFIX_WIDGET_ID=replace_me
# Origin of the hosted widget page (only change for a self-hosted ClickFix)
CLICKFIX_ORIGIN=https://getclickfix.com
# Your backend that serves GET /api/support-session (../node-express, ../go-server or ../php-plain)
API_URL=http://10.0.2.2:3000
# Optional: open this conversation when the support screen opens (deep link)
CLICKFIX_CONVERSATION=
