# Public widget id: Web widget -> Install. Safe to expose (NEXT_PUBLIC_).
NEXT_PUBLIC_CLICKFIX_WIDGET_ID=replace_me
# Origin that serves widget.js (only change for a self-hosted ClickFix).
NEXT_PUBLIC_CLICKFIX_APP_ORIGIN=https://getclickfix.com
# Web widget -> Security -> Identity verification. Server only: never NEXT_PUBLIC_.
CLICKFIX_IDENTITY_SECRET=replace_me
